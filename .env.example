# TLQ IQ Test — Environment Configuration
# Copy this file to .env and fill in your values
# .env is gitignored and should NEVER be committed

# ─── Server ────────────────────────────────────────────────────────────────
# Public URL of the deployed server (used for share links and image URLs)
APP_URL=https://your-domain.com

# TCP port for the Express server
PORT=3000

# ─── Telegram Bot ──────────────────────────────────────────────────────────
# Obtain from @BotFather on Telegram
# If not set, the Telegram bot will not start (no crash — just skipped)
TELEGRAM_BOT_TOKEN=

# ─── Discord Bot ───────────────────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications
# Add a Bot to the application and copy its token here
DISCORD_BOT_TOKEN=

# Client ID (Application ID) from the General Information page
DISCORD_CLIENT_ID=

# (Optional) Guild ID for faster command registration during development
# Leave empty for global command registration (takes up to 1 hour)
DISCORD_GUILD_ID=
